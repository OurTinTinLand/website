{
  "name": "pocketbase-cli",
  "version": "0.1.7",
  "description": "Remote-only PocketBase CLI (TypeScript)",
  "license": "MIT",
  "type": "commonjs",
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "README.zh-CN.md"
  ],
  "bin": {
    "pocketbase-cli": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "prepack": "npm run build",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "dev": "tsup --watch"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^11.0.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^9.39.4",
    "globals": "^17.4.0",
    "tsup": "^8.5.1",
    "typescript": "^5.5.0",
    "vitest": "^4.1.2"
  }
}
