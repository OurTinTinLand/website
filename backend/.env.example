# TinTinLand 后端 · 环境变量样例
# 复制为 .env 后按需修改（.env 已在 .gitignore）
#
# 本地开发默认值（无需设置即可启动）：
#   PORT=8090
#   PB_ORIGINS=*
#
# Railway / Render / Fly.io 等平台会自动注入 PORT（默认 8080）。

# ─────────────────────────────────────────────────────────────
# 必填（生产）
# ─────────────────────────────────────────────────────────────

# CORS 来源：逗号分隔的完整 origin（含 protocol）。
#   生产推荐显式列出所有合法前端域名。
#   dev/staging 留空 = *（允许所有）。
# PB_ORIGINS=https://tintin.land,https://www.tintin.land

# PocketBase settings/字段加密用 32 字符 key（用 `openssl rand -hex 16` 生成）
# ENCRYPTION_ENV=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────
# 邮件发送（生产）
# ─────────────────────────────────────────────────────────────
# PB_SMTP_HOST=smtp.example.com
# PB_SMTP_PORT=587
# PB_SMTP_USERNAME=...
# PB_SMTP_PASSWORD=...

# ─────────────────────────────────────────────────────────────
# 可选
# ─────────────────────────────────────────────────────────────

# 统一镜像启动后，PocketBase 内部端口（外部 PORT 由平台注入）。
# 默认 8090；除非改了 Dockerfile 不用改。
# PB_PORT=8090

# 微信 / 钱包登录回调（V1.1 接真实 OAuth 时填）
# WECHAT_APP_ID=...
# WECHAT_APP_SECRET=...
