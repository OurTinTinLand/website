{
  "name": "tintin-react",
  "version": "1.2.0",
  "description": "TinTinLand 官网 React 拆分 + esbuild 编译版。pb_public 单进程架构：esbuild 把 src/App.jsx 编到 backend/pb_public/dist/bundle.js，由 PocketBase --publicDir 直接 serve。所有依赖（React / @privy-io/react-auth / wagmi / viem / zustand / @solana/kit）从 node_modules 打进 bundle.js，零 esm.sh 运行时请求。详见 PRIVY.md。",
  "private": true,
  "scripts": {
    "build": "node build.js",
    "watch": "node build.js --watch",
    "clean": "rm -rf backend/pb_public/dist backend/pb_public/index.html backend/pb_public/src backend/pb_public/assets-claude",
    "serve:pb": "bash backend/start.sh",
    "dev": "node build.js --watch & npm run serve:pb",
    "serve:original": "node server-original.js",
    "verify:privy": "node -e \"require.resolve('@privy-io/react-auth');console.log('OK @privy-io/react-auth located')\""
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@privy-io/react-auth": "3.37.4",
    "@solana/kit": "^6.5.0",
    "@solana-program/system": "^0.12.0",
    "@solana-program/token": "^0.13.0",
    "@stripe/stripe-js": "^9.14.0",
    "@wagmi/connectors": "5.1.0",
    "pocketbase": "^0.28.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "viem": "2.21.0",
    "wagmi": "2.12.0",
    "zustand": "4.5.0"
  }
}
